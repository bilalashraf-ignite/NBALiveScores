// Prisma schema for Basketball Live Scores
// Database: PostgreSQL (Vercel Postgres in production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Authentication Models (NextAuth.js)
// ============================================

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?    // Avatar URL from Cloudinary
  password      String?    // Hashed password, null for OAuth-only users
  phone         String?
  bio           String?
  location      String?
  birthday      DateTime?
  gender        String?
  status        UserStatus @default(ACTIVE)
  lastVerificationEmailSent DateTime? // Rate limiting for verification emails
  lastPasswordResetEmailSent DateTime? // Rate limiting for password reset emails
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  walletAccounts WalletAccount[]
  starPointPurchases StarPointPurchase[]
  starPointLedgerEntries StarPointLedgerEntry[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum WalletProvider {
  STRIPE
}

enum WalletAccountStatus {
  ACTIVE
  DISABLED
}

enum WalletPaymentMethodType {
  LINK
  CARD
  UNKNOWN
}

enum WalletPaymentMethodStatus {
  ACTIVE
  DETACHED
}

enum StarPointPurchaseStatus {
  CREATED
  CHECKOUT_STARTED
  PAYMENT_PENDING
  PAID
  POINTS_GRANTED
  FAILED
  CANCELED
  REFUNDED
}

enum StarPointLedgerEntryType {
  CREDIT_PURCHASE
  DEBIT_SPEND
  DEBIT_REFUND
  CREDIT_ADJUSTMENT
  DEBIT_ADJUSTMENT
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model WalletAccount {
  id                 String                 @id @default(cuid())
  userId             String
  provider           WalletProvider
  providerCustomerId String
  status             WalletAccountStatus    @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethods     WalletPaymentMethod[]
  purchases          StarPointPurchase[]

  @@unique([provider, userId])
  @@unique([provider, providerCustomerId])
}

model WalletPaymentMethod {
  id                      String                    @id @default(cuid())
  walletAccountId         String
  providerPaymentMethodId String
  type                    WalletPaymentMethodType   @default(UNKNOWN)
  brand                   String?
  last4                   String?
  expMonth                Int?
  expYear                 Int?
  isDefault               Boolean                   @default(false)
  status                  WalletPaymentMethodStatus @default(ACTIVE)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  walletAccount           WalletAccount             @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)

  @@unique([walletAccountId, providerPaymentMethodId])
  @@index([walletAccountId, status])
}

model StarPointPurchase {
  id                      String                  @id @default(cuid())
  userId                  String
  walletAccountId         String?
  status                  StarPointPurchaseStatus @default(CREATED)
  provider                WalletProvider
  productCode             String
  currency                String
  amountCents             Int
  points                  Int
  idempotencyKey          String                  @unique
  providerSessionId       String?                 @unique
  providerPaymentIntentId String?                 @unique
  providerChargeId        String?                 @unique
  metadata                Json?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  completedAt             DateTime?

  user                    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAccount           WalletAccount?          @relation(fields: [walletAccountId], references: [id], onDelete: SetNull)
  ledgerEntries           StarPointLedgerEntry[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model StarPointLedgerEntry {
  id           String                   @id @default(cuid())
  userId       String
  purchaseId   String?
  entryType    StarPointLedgerEntryType
  pointsDelta  Int
  reason       String
  metadata     Json?
  createdAt    DateTime                 @default(now())

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase     StarPointPurchase?       @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([purchaseId, entryType])
}

model WebhookEvent {
  id              String             @id @default(cuid())
  provider        WalletProvider
  providerEventId String
  eventType       String
  status          WebhookEventStatus @default(RECEIVED)
  payloadHash     String
  errorMessage    String?
  processedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, createdAt])
}

// ============================================
// Sports Data Models
// ============================================

// Team model - Represents basketball teams across all leagues
model Team {
  id           String   @id @default(cuid())
  name         String
  abbreviation String   @unique
  logoUrl      String?
  league       String   // "NBA", "NCAA", "EUROLEAGUE"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  homeGames    Game[]   @relation("HomeTeam")
  awayGames    Game[]   @relation("AwayTeam")

  @@index([league])
}

// Game model - Represents basketball games with real-time state tracking
// Note: scheduledTime always stored in UTC per PITFALLS.md Pitfall 3
model Game {
  id            String   @id @default(cuid())
  externalId    String?  @unique  // ID from external API
  homeTeamId    String
  awayTeamId    String
  homeScore     Int      @default(0)
  awayScore     Int      @default(0)
  state         String   // Maps to GameState enum (scheduled, live, halftime, final, postponed, cancelled)
  scheduledTime DateTime // Always stored in UTC per PITFALLS.md Pitfall 3
  period        Int?
  timeRemaining String?
  possession    String?  // "home" or "away"
  league        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  homeTeam      Team     @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team     @relation("AwayTeam", fields: [awayTeamId], references: [id])

  @@index([state])
  @@index([scheduledTime])
  @@index([league])
}
