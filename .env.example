# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/basketball_scores

# Redis Cache
REDIS_URL=redis://localhost:6379

# Sports API Keys
SPORTS_API_KEY=your_api_key_here
SPORTS_API_BASE_URL=https://api.example.com

# Basketball API (balldontlie.io)
BALLDONTLIE_API_KEY=your_balldontlie_api_key

# Football API (api-sports.io)
FOOTBALL_API_KEY=your_football_api_key

# Cricket API (cricketdata.org)
# Sign up at https://cricketdata.org to get your API key
CRICKET_API_KEY=your_cricket_api_key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth (https://developers.facebook.com/)
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Cloudinary (https://cloudinary.com/)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=user-avatars

# SMTP for Email (verification, password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourdomain.com

# Stripe Wallet / Star Points
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
